# Homepage container binding
HTTP_BIND_HOST=127.0.0.1
HOMEPAGE_PORT=17201

# 문의 챗봇 '한지수' (chat/)
CHAT_PORT=17204
CHAT_ENABLED=true
OPENAI_API_KEY=                 # 챗봇 전용 키 권장
CHAT_MODEL=gpt-5.6-luna
CHAT_REASONING_EFFORT=low       # minimal|low
CHAT_MAX_OUTPUT_TOKENS=300
CHAT_MAX_TURNS=20
CHAT_MAX_MESSAGE_CHARS=500
CHAT_RATE_PER_MINUTE=10
CHAT_RETENTION_DAYS=90
TELEGRAM_BOT_TOKEN=             # 알림 전용 봇 (@trr_hanjisu_bot)
TELEGRAM_CHAT_ID=               # "트라움 문의" 그룹 chat_id (음수)
